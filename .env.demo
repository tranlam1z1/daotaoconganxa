# Cấu hình bản demo chạy trên máy (docs/DEMO.md). `bun run demo` đọc tệp này, đè lên .env.
#
# Tệp này KHÔNG chứa bí mật và được đưa vào git. Giá trị riêng của từng máy (chuỗi kết nối kho
# thật, key AI, mật khẩu) đặt ở .env.demo.local: tệp đó bị git bỏ qua và đè lên tệp này.
#
# Mọi giá trị dưới đây cố ý tách demo khỏi hệ thống thật: CSDL riêng trên máy, kho tệp riêng,
# không Redis, không R2, không gửi thông báo.

# --- CSDL demo: Postgres trong Docker (infra/docker-compose.yml, cổng 5436) ---
# CSDL riêng tên quydinhphapluat_demo, `bun run demo` tự tạo nếu chưa có. Không dùng chung với
# CSDL test (quydinhphapluat_test) để `bun test` không xóa mất dữ liệu demo.
DATABASE_URL=postgres://qdpl:qdpl_dev@127.0.0.1:5436/quydinhphapluat_demo
DATABASE_URL_DIRECT=postgres://qdpl:qdpl_dev@127.0.0.1:5436/quydinhphapluat_demo
PG_POOL_MAX=5

# Nguồn văn bản giao thông: chuỗi kết nối kho thật, quyền chỉ đọc là đủ. ĐẶT Ở .env.demo.local,
# không đặt ở đây. Bỏ trống thì demo chỉ có hai văn bản mẫu.
DEMO_NGUON_DATABASE_URL=

# --- Cổng: tránh 3030/3031 (máy chủ dev) để chạy demo không tắt máy chủ đang dùng ---
DEMO_WEB_PORT=3080
DEMO_API_PORT=3081
# Nghe trên mọi địa chỉ mạng để điện thoại cùng Wi-Fi mở được.
HOST=0.0.0.0

# --- Bảo vệ API (docs/PLAN.md GĐ0) ---
# Origin được gọi API thẳng từ trình duyệt. `bun run demo` tự thêm địa chỉ LAN và đường hầm.
CORS_ORIGINS=http://localhost:3080,http://127.0.0.1:3080
ASK_QUOTA_PER_DAY=30
# Chỉ cho bản demo: vẫn chạy được tài khoản demo quản trị nếu có đặt AUTH_DEMO_PASSWORD.
# Không bao giờ chép dòng này lên máy chủ thật.
AUTH_DEMO_ADMIN=1
# Đăng nhập demo bằng mật khẩu chung: tắt. Demo dùng các tài khoản mẫu có tên đăng nhập riêng.
AUTH_DEMO_PASSWORD=
AUTH_BOOTSTRAP_ADMIN=0
GOOGLE_CLIENT_ID=
# Mật khẩu chung của các tài khoản mẫu (seed-don-vi.ts).
SEED_MAT_KHAU=Matkhau2026

# --- AI ---
# none: hỏi đáp AI báo "chưa cấu hình". Có key thì đặt ở .env.demo.local:
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_PROVIDER=auto
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=local

# --- Dịch vụ ngoài: tắt hết ---
REDIS_URL=
STORAGE_BACKEND=local
STORAGE_DIR=./data/demo
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
