{
  "name": "quydinhphapluat",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:tra-cuu": "bun run scripts/kiem-thu-tra-cuu.ts",
    "nhom:kiem-ke": "bun run scripts/ra-soat-ba-nhom.ts",
    "dev": "bun run scripts/serve.ts web api",
    "dev:web": "bun run scripts/serve.ts web",
    "dev:api": "bun run scripts/serve.ts api",
    "dev:mcp": "bun run scripts/serve.ts mcp",
    "dev:all": "bun run scripts/serve.ts --all",
    "thu": "bun run scripts/serve.ts --profile thu web api",
    "thu:web": "bun run scripts/serve.ts --profile thu web",
    "thu:api": "bun run scripts/serve.ts --profile thu api",
    "thu:mcp": "bun run scripts/serve.ts --profile thu mcp",
    "thu:all": "bun run scripts/serve.ts --profile thu --all",
    "port:free": "bun run scripts/free-port.ts",
    "build": "bun run --cwd apps/web build",
    "build:web": "bun run --cwd apps/web build",
    "build:server": "echo 'Thành phần chạy thẳng mã nguồn TypeScript bằng Bun, không cần bước build.'",
    "start:web": "bun run --cwd apps/web start",
    "start:api": "bun run apps/api/src/index.ts",
    "start:mcp": "bun run apps/mcp/src/index.ts --http",
    "start:worker": "bun run apps/workers-ts/src/cli.ts bull worker",
    "deploy:migrate": "bun run packages/db/src/migrate.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:seed": "bun run packages/db/src/seed.ts",
    "db:seed:dao-tao": "bun run packages/db/src/seed-dao-tao.ts",
    "db:seed:dao-tao:gtdb": "bun run packages/db/src/seed-dao-tao-gtdb.ts",
    "db:seed:ngan-hang": "bun run packages/db/src/seed-ngan-hang.ts",
    "db:seed:don-vi": "bun run packages/db/src/seed-don-vi.ts",
    "db:reset": "bun run scripts/db-reset.ts",
    "worker": "bun run apps/workers-ts/src/worker.ts",
    "pipeline": "bun run apps/workers-ts/src/cli.ts",
    "crawl": "bun run apps/workers-ts/src/cli.ts crawl",
    "mcp": "bun run apps/mcp/src/index.ts",
    "smoke": "bun run scripts/smoke.ts",
    "e2e": "bun run scripts/e2e/chay.ts",
    "demo": "bun run scripts/demo.ts",
    "quality": "bun run scripts/quality-report.ts",
    "eval": "bun run evals/run-citation-eval.ts && bun run evals/run-structure-eval.ts",
    "citations:check": "bun run scripts/check-citations.ts",
    "tra-cuu:nap": "bun run scripts/tra-cuu-nhanh.ts",
    "dia-gioi:dung": "bun run scripts/dia-gioi.ts",
    "thon:dung": "bun run scripts/thon.ts",
    "ranh-gioi:dung": "bun run scripts/ranh-gioi.ts",
    "bien-bao:nap": "bun run scripts/bien-bao.ts",
    "bien-bao:nap:qcvn": "bun run scripts/nap-bien-bao-qcvn.ts",
    "muc-phat:nap:reviewed": "bun run scripts/nap-muc-phat-reviewed.ts",
    "content:check": "bun run scripts/kiem-tra-bai-hoc.ts",
    "index": "bun run packages/search/src/cli.ts",
    "corpus:load": "bun run scripts/corpus.ts nap",
    "corpus:check": "bun run scripts/corpus.ts doi-soat",
    "monitor": "bun run scripts/giam-sat.ts",
    "monitor:watch": "bun run scripts/giam-sat.ts --theo-doi",
    "huong-dan:kiem-tra": "bun run scripts/huong-dan.ts kiem-tra",
    "huong-dan:cap-nhat": "bun run scripts/huong-dan.ts cap-nhat",
    "huong-dan:pdf": "bun run scripts/huong-dan.ts pdf",
    "redis:up": "docker compose -f infra/docker-compose.yml up -d redis",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/bun": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "mupdf": "^1.28.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  }
}
