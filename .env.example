# CSDL chính: Postgres do DigitalOcean quản lý (cụm db-postgresql-sgp1-06837, sgp1).
# Lấy mật khẩu ở bảng điều khiển DO -> Databases -> Users -> qdpl.
# Cổng 25061 = PgBouncer (pool "qdpl", transaction, size 3). BẮT BUỘC dùng cổng này cho
# ứng dụng: cụm chỉ có ~22 kết nối cho ~20 CSDL, nối thẳng sẽ làm cạn slot của mọi dự án.
DATABASE_URL=postgresql://qdpl:<mat-khau>@db-postgresql-sgp1-06837-do-user-17889737-0.g.db.ondigitalocean.com:25061/qdpl?sslmode=require
# Nối thẳng, chỉ dùng cho migration và thao tác cần trạng thái phiên.
DATABASE_URL_DIRECT=postgresql://qdpl:<mat-khau>@db-postgresql-sgp1-06837-do-user-17889737-0.g.db.ondigitalocean.com:25060/qdpl?sslmode=require
# Số kết nối tối đa MỖI tiến trình (api, worker, mcp, script đều mở pool riêng).
PG_POOL_MAX=3
# CSDL cho `bun test`. PHẢI là Postgres cục bộ (bun run db:up): test-setup tự tạo/xóa
# CSDL <tên>_test, việc mà user qdpl trên DigitalOcean không có quyền làm — và cũng
# không được đụng vào kho thật.
DATABASE_URL_TEST=postgres://qdpl:qdpl_dev@127.0.0.1:5436/quydinhphapluat_test
# --- Kho đối tượng (bản gốc PDF, ảnh trang, bản sao Markdown) ---
# Thư mục cục bộ, dùng khi chưa cấu hình R2. Cũng là nơi giữ bản sao và tệp tạm khi dùng R2.
STORAGE_DIR=./data
# Đủ bốn biến R2_* thì tự dùng Cloudflare R2; thiếu bất kỳ biến nào thì lùi về STORAGE_DIR.
# Đặt STORAGE_BACKEND=local để ép dùng thư mục, =r2 để bắt buộc dùng R2 (thiếu biến sẽ báo lỗi).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=            # mặc định https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=          # tên miền công khai của bucket, nếu có
# STORAGE_BACKEND=
# STORAGE_CACHE_DIR=      # nơi giữ bản sao cục bộ của đối tượng R2, mặc định $STORAGE_DIR/cache-r2

# --- Số hóa văn bản bằng agent (ke-hoach/05) ---
# Thời gian một phiên MCP giữ một việc số hóa (phút). Quá hạn thì phiên khác nhận lại được.
SOHOA_LEASE_MINUTES=180
# --- Hàng đợi nạp kho (BullMQ + Redis) ---
# Bắt buộc cho việc nạp kho dài ngày. Không có Redis thì worker BullMQ không chạy;
# các lệnh nhẹ vẫn dùng hàng đợi trong Postgres (bảng jobs).
# Dạng: redis://[user:password@]host:port[/db]  hoặc  rediss://... nếu có TLS
# Valkey do DigitalOcean quản lý (cụm db-valkey-sgp1-39341). Lấy mật khẩu ở bảng điều khiển DO.
REDIS_URL=rediss://default:<mat-khau>@db-valkey-sgp1-39341-do-user-17889737-0.m.db.ondigitalocean.com:25061
# Cụm này DÙNG CHUNG với các dự án khác. Không lẫn nhau vì mọi tên hàng đợi đã mang tiền tố
# `qdpl-` (packages/queue/src/types.ts) nên khóa BullMQ là `bull:qdpl-*`.
# Số job chạy song song tối đa cho mỗi hàng đợi (bỏ trống dùng mặc định ở packages/queue)
# QUEUE_CONCURRENCY=

# --- Đăng nhập Google (Identity Services) ---
# Client ID của "OAuth 2.0 Client ID" loại Web application trên Google Cloud Console.
# Thiếu biến này thì trang /dang-nhap báo "chưa cấu hình" và MCP HTTP không ai vào được.
# Trong mục Authorized JavaScript origins phải khai đúng địa chỉ trang web sẽ hiện nút,
# ví dụ http://localhost:3030 (dev) và https://quydinhphapluat.vn (thật).
GOOGLE_CLIENT_ID=
# Chỉ nhận tài khoản thuộc các miền này, phân tách bằng dấu phẩy. Rỗng = không giới hạn.
AUTH_ALLOWED_DOMAINS=
# Vai trò cho tài khoản mới: khach | tra_cuu | bien_tap | phap_che | quan_tri
AUTH_DEFAULT_ROLE=khach
# Người ĐĂNG NHẬP ĐẦU TIÊN của một kho chưa có tài khoản nào được cấp vai trò quan_tri,
# để hệ thống mới dựng có người quản trị mà không phải sửa CSDL bằng tay. Đặt =0 để tắt
# (nên tắt sau khi đã có quản trị, hoặc khi mở cho công chúng trước lúc lập quản trị).
AUTH_BOOTSTRAP_ADMIN=1
# Hạn token phiên, tính bằng giờ. Mặc định 336 (14 ngày).
# AUTH_SESSION_TTL_HOURS=336
# Đăng nhập tài khoản demo bằng mật khẩu chung (trang /dang-nhap), để trình diễn khi chưa
# dùng được Google. Rỗng = tắt. Hai tài khoản: hoc-vien@demo… (khach) và quan-tri@demo… (quan_tri).
# Đổi hoặc xóa mật khẩu sau buổi trình diễn: ai biết mật khẩu cũng vào được quyền quản trị.
AUTH_DEMO_PASSWORD=
# Khi NODE_ENV=production, tài khoản demo quan_tri bị tắt dù đã đặt mật khẩu demo (docs/PLAN.md
# GĐ0 S4). Chỉ đặt =1 cho buổi trình diễn có kiểm soát; không bao giờ đặt trên máy chủ thật.
# AUTH_DEMO_ADMIN=
# --- Bảo vệ API (docs/PLAN.md GĐ0) ---
# Số câu hỏi AI tối đa mỗi tài khoản mỗi ngày (tính theo ngày giờ Việt Nam). Mặc định 30;
# giá trị không phải số nguyên dương cũng dùng 30.
ASK_QUOTA_PER_DAY=30
# Origin được gọi API thẳng từ trình duyệt, phân tách bằng dấu phẩy. Bỏ trống: máy phát triển
# cho mọi origin, máy chủ thật (NODE_ENV=production) không cho origin nào.
# CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030
CORS_ORIGINS=

# --- Giọng đọc của mascot (Vbee) ---
# App ID và access token lấy ở trang quản lý API của Vbee. Thiếu một trong hai thì hộp thoại
# mascot không hiện nút giọng đọc. Bản đọc lưu vào kho đối tượng dưới giong-doc/.
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Mã giọng, ví dụ: hn_female_ngochuyen_full_48k-fhg (Ngọc Huyền) | hn_female_maiphuong_vdts_48k-fhg
# | hn_male_manhdung_news_48k-fhg | hn_male_thanhlong_talk_48k-fhg | sg_female_thaotrinh_full_48k-fhg.
# Danh sách đủ: GET https://vbee.vn/api/public/v1/voices?voiceOwnership=VBEE&languageCode=vi-VN
VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg
# Tốc độ đọc, 0.1–1.9. Mặc định 1.
# VBEE_SPEED=1

# Trên máy chủ thật (DigitalOcean App Platform) chỉ cần đặt NODE_ENV=production: nền tảng tự
# đặt PORT cho từng thành phần, mã nguồn đọc biến đó và lắng nghe ở 0.0.0.0.
# Xem docs/trien-khai-do.md.
# NODE_ENV=production

# Cổng do sơ đồ trong packages/config quyết định theo QDPL_PROFILE:
#   dev (mặc định): web 3030, api 3031, mcp 3032
#   thu            : web 3060, api 3061, mcp 3062
# Bỏ ghi chú các dòng dưới nếu muốn ép cổng cụ thể.
# QDPL_PROFILE=dev
# PORT=3031
# WEB_PORT=3030
# MCP_PORT=3032
# API_URL=http://127.0.0.1:3031
# LLM: để trống -> dùng provider mock/replay (fixtures). Đặt key để chạy thật.
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto            # auto | anthropic | mock | none
# none: máy chủ không có dịch vụ AI. Hỏi đáp AI báo "chưa cấu hình" thay vì trả câu trả lời giữ
# chỗ của mock (dùng cho bản demo chưa có key). Các việc khác vẫn chạy như mock.
LLM_MODEL_HEAVY=claude-opus-5
LLM_MODEL_BULK=claude-sonnet-5
LLM_MODEL_LIGHT=claude-haiku-4-5
LLM_CACHE_DIR=./data/llm-cache
# Soạn bài bằng AI (tạo chuyên đề từ tệp PDF). Bỏ trống SOAN_BAI_TRONG_API thì API tự dò: có worker
# soan-bai đang nghe thì đẩy hàng đợi, không thì chạy ngay trong API. 1 = luôn chạy trong API,
# 0 = luôn đẩy hàng đợi.
# SOAN_BAI_TRONG_API=
# SOAN_BAI_SONG_SONG=3          # số việc soạn chạy cùng lúc khi chạy trong API
# SOAN_TU_DONG_TRAN_USD=20      # ước tính vượt mức này thì cần vai trò pháp chế
# DOC_PDF_QUET_TANG=bulk        # mô hình đọc PDF bản quét: bulk | heavy (chính xác hơn, đắt hơn nhiều)
# DOC_PDF_QUET_TRANG_TOI_DA=150 # trần số trang của một lần đọc bản quét
# Embedding: mock (hash-based) khi không có server TEI
EMBEDDING_PROVIDER=local     # local | tei
EMBEDDING_URL=http://127.0.0.1:8080
EMBEDDING_DIM=1024
CRAWLER_USER_AGENT=quydinhphapluat.vn-bot/0.1 (+https://quydinhphapluat.vn/bot)
CRAWLER_RPS=1
# Thông báo đẩy nhắc học (docs/PLAN.md GĐ15). Sinh cặp khóa: bunx web-push generate-vapid-keys
# Để trống thì trang "Tôi" báo chưa cấu hình và worker nhac-hoc bỏ qua, không gửi gì.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hotro@quydinhphapluat.vn

# Tên đường, số nhà cho công cụ địa giới (apps/api/src/nominatim.ts). Để trống dùng máy chủ công cộng
# nominatim.openstreetmap.org (tối đa 1 lượt/giây); "off" để tắt. User-Agent nên kèm liên hệ theo chính
# sách của máy chủ công cộng, ví dụ: quydinhphapluat/1.0 (hotro@quydinhphapluat.vn)
NOMINATIM_URL=
NOMINATIM_USER_AGENT=
