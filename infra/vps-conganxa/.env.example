# Chép thành .env trên VPS (không đưa .env vào git). Thay mọi DOI_MAT_KHAU bằng cùng một mật khẩu.
PGPASSWORD=DOI_MAT_KHAU
DATABASE_URL=postgres://qdpl:DOI_MAT_KHAU@db:5432/conganxa_demo
DATABASE_URL_DIRECT=postgres://qdpl:DOI_MAT_KHAU@db:5432/conganxa_demo
PG_POOL_MAX=5
CORS_ORIGINS=https://conganxa.daotaonghiepvu.click
ASK_QUOTA_PER_DAY=30
AUTH_DEMO_ADMIN=1
AUTH_DEMO_PASSWORD=
AUTH_BOOTSTRAP_ADMIN=0
AUTH_DEFAULT_ROLE=khach
GOOGLE_CLIENT_ID=
SEED_MAT_KHAU=DOI_MAT_KHAU_TAI_KHOAN_MAU
DEMO_NGUON_DATABASE_URL=
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=local
REDIS_URL=
STORAGE_BACKEND=local
STORAGE_DIR=/data
